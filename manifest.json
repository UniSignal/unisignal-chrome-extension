{
  "manifest_version": 3,
  "name": "UniSignal Telegram Feed",
  "version": "2.1.2",
  "description": "在 GMGN 混排或悬浮展示 Telegram 推送，在 DeBot、Binance Web3 使用悬浮窗查看。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "GMGN：切换混排 / 悬浮；DeBot、Binance Web3：显示 / 隐藏悬浮窗",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "notification-sound.mp3",
        "icons/icon32.png",
        "icons/Telegram_logo.svg"
      ],
      "matches": [
        "https://gmgn.ai/*",
        "https://debot.ai/*",
        "https://web3.binance.com/*"
      ]
    },
    {
      "resources": [
        "icons/GMGN_logo.svg"
      ],
      "matches": [
        "https://gmgn.ai/*"
      ]
    },
    {
      "resources": [
        "icons/DeBot_logo.png"
      ],
      "matches": [
        "https://debot.ai/*"
      ]
    },
    {
      "resources": [
        "icons/Binance_logo.png"
      ],
      "matches": [
        "https://web3.binance.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*"
      ],
      "js": [
        "gmgn-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://debot.ai/*",
        "https://web3.binance.com/*"
      ],
      "js": [
        "floating-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://debot.ai/*",
        "https://web3.binance.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
